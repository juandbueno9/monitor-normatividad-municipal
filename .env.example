# Copia este archivo a ".env" y completa los valores reales.
# NUNCA subas el archivo ".env" (con secretos reales) a git ni lo compartas.

# --- Microsoft Entra ID / App Registration (OAuth2 Client Credentials) ---
MS_TENANT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_SECRET=coloca-aqui-el-valor-del-secreto

# --- Envio de correo (Microsoft Graph) ---
# Buzon que actua como remitente. Requiere permiso de aplicacion "Mail.Send"
# (con consentimiento de administrador) sobre este buzon en Entra ID.
MAIL_SENDER=alertas@empresa.com
# Uno o varios destinatarios separados por coma.
MAIL_RECIPIENTS=alertas@empresa.com

# --- Scraper ---
# Cuantas publicaciones recientes se consultan por ejecucion.
SCRAPE_PAGE_SIZE=30

# --- Logging ---
# DEBUG, INFO, WARNING o ERROR
LOG_LEVEL=INFO
